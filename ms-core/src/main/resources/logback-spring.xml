<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared logging setup for every service that depends on ms-core.

  Everything a service writes to the console is also written, one JSON object per line,
  to <log dir>/<spring.application.name>/<spring.application.name>.log so a log shipper
  (Fluent Bit, Filebeat, Vector, CloudWatch agent, ...) can tail it and push it to central storage.

  <log dir> is logging.file.path (env LOGGING_FILE_PATH), defaulting to ../logs, which is the
  repository's logs/ folder when a service runs from its own directory (gradlew bootRun).
  A service can still override this by shipping its own logback-spring.xml.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty name="SERVICE_NAME" source="spring.application.name" defaultValue="unknown-service"/>
    <springProperty name="LOG_ROOT" source="logging.file.path" defaultValue="../logs"/>
    <property name="SERVICE_LOG_DIR" value="${LOG_ROOT}/${SERVICE_NAME}"/>

    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${SERVICE_LOG_DIR}/${SERVICE_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${SERVICE_LOG_DIR}/archive/${SERVICE_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${LOG_FILE_MAX_SIZE:-50MB}</maxFileSize>
            <maxHistory>${LOG_FILE_MAX_HISTORY:-14}</maxHistory>
            <totalSizeCap>${LOG_FILE_TOTAL_SIZE_CAP:-2GB}</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${SERVICE_NAME}"}</customFields>
        </encoder>
    </appender>

    <!-- File writes never block request threads; events are dropped only if the queue is full -->
    <appender name="ASYNC_JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_FILE"/>
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_JSON_FILE"/>
    </root>
</configuration>
